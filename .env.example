# ==============================================================================
# CraftyWrap Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the root directory before running docker-compose:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or credentials to Git repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Express Service)
# ------------------------------------------------------------------------------
PORT=5000

# Managed External Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/craftywrap?retryWrites=true&w=majority

# CORS Configuration (Allowed frontend origin in production / local dev)
FRONTEND_ORIGIN=http://localhost:3000

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Test Mode Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js Service)
# ------------------------------------------------------------------------------
# Browser API Endpoint (Used by client-side browser fetch requests)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Client-side Public Integration Keys
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
