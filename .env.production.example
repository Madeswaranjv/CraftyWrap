# ==============================================================================
# CraftyWrap Production Environment Template (.env.production.example)
# ==============================================================================
# REFERENCE ONLY: Do NOT load this file directly in code or commit real secrets.
# Use these environment variable keys and formats when configuring your production
# host settings (e.g., Render, Vercel, AWS, Railway, DigitalOcean).
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Express Service / Render / Node server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production Database Connection String
MONGODB_URI=mongodb+srv://<prod_db_user>:<prod_db_password>@craftywrap.jhk0kpj.mongodb.net/craftywrap?retryWrites=true&w=majority

# CORS Configuration (Comma-separated allowed origins for live site)
FRONTEND_URL=https://craftywrap.com,https://www.craftywrap.com
FRONTEND_ORIGIN=https://craftywrap.com,https://www.craftywrap.com

# Production JWT Secret (Use a strong 64+ char random string)
JWT_SECRET=your_production_long_random_jwt_secret_key_here

# Google OAuth Web Client ID (Configured with production origin in Google Cloud Console)
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway API Keys (PRODUCTION LIVE MODE)
# NOTE: Switch key prefix from `rzp_test_` to `rzp_live_` once Razorpay KYC is approved!
RAZORPAY_KEY_ID=rzp_live_YOUR_PRODUCTION_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_PRODUCTION_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET

# Cloudinary Production Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js Service / Vercel)
# ------------------------------------------------------------------------------
# Production App Base URL
NEXT_PUBLIC_APP_URL=https://craftywrap.com

# Production API Endpoint (e.g. backend on sub-domain or backend path)
# If backend is on api.craftywrap.com: https://api.craftywrap.com/api
# If backend is on Render: https://craftywrap-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://craftywrap.com/api

# Client-side Public Integration Keys (Live Mode)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_PRODUCTION_KEY_ID
